{
  "slug": "winloss-qa",
  "name": "Win/loss and maintenance Q&A",
  "kind": "qa",
  "description": "20 questions over the synthetic win/loss reports and maintenance manuals: single-document questions, aggregate questions that need the records tool, and two unanswerable questions that must be refused.",
  "cases": [
