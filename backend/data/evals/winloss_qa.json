      "id": "q01-nordgrid-lost",
      "question": "Why did we lose the Nordgrid Utilities deal?",
      "expected_facts": ["VoltEdge", "price"],
      "expected_docs": ["wl-001-nordgrid"],
      "expected_tools": ["search_documents"]
    },
    {
      "id": "q02-rheinland-won",
